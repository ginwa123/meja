.{
    .name = .meja,
    .version = "0.0.0",
    // Tracks the earliest Zig version that the package considers a
    // supported use case. Both path deps below require 0.16.0 too.
    .fingerprint = 0x3b32bea2a01abe5,
    .minimum_zig_version = "0.16.0",

    // Both dependencies are LOCAL path deps. Zig 0.16 REJECTS absolute
    // paths here, so these must stay relative to this file's directory.
    //
    //   ../ruangsql     -> `databases` module: sqlite3 + libpq bindings.
    //                      Ships the vendored amalgamation under
    //                      vendor/sqlite3/ (gitignored upstream) which is
    //                      what makes non-Linux targets linkable.
    //   ../glinlandui   -> cross-platform immediate-mode GUI toolkit
    //                      (Wayland/EGL on Linux, Cocoa on macOS,
    //                      D3D11 on Windows). Supplies a *portable*
    //                      headless backend in test builds, so GUI code
    //                      is testable without a display server.
    .dependencies = .{
        .databases = .{ .path = "../ruangsql" },
        .glinlandui = .{ .path = "../glinlandui" },
        // The linter (github.com/ginwa123/zglint), pinned by URL + hash.
        // `zig build zginlint:check` is the gate; the tool is std-only.
        // Move the pin: `zig fetch "git+https://github.com/ginwa123/zglint.git#<sha>"`.
        .zginlint = .{
            .url = "git+https://github.com/ginwa123/zglint.git#7e1faeba4d75640c7ae37efe2987f6be85fa2a89",
            .hash = "zginlint-0.0.0-0kYHpg4dAQARigMlrQ54kyJUpbIlGU0fYVNhFMDuUvah",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "docs",
    },
}
